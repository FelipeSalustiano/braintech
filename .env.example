# Chaves usadas pelos scripts Python (scripts/supabase_*.py).
# Copie para .env (na raiz) e preencha. O .env não vai para o git.
#
# Supabase na nuvem: painel do projeto > Project Settings > API Keys / Data API.
# Supabase local:    rode `npx supabase status` e copie "API URL" e "Secret" (ou "service_role key").

SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave SECRETA (sb_secret_... ou a antiga service_role). Ignora as regras de acesso:
# use só nos scripts, nunca no front-end, nunca no git.
SUPABASE_SECRET_KEY=

# Domínio usado para transformar "usuário" em e-mail no login (maria -> maria@voltlens.local).
# Tem que ser o mesmo VITE_LOGIN_DOMAIN do frontend/.env.local.
VOLTLENS_LOGIN_DOMAIN=voltlens.local

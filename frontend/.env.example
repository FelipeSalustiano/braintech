# Copie para frontend/.env.local e preencha. O .env.local não vai para o git.
#
# Supabase na nuvem: painel do projeto > Project Settings > API Keys / Data API.
# Supabase local:    rode `npx supabase status` e copie "API URL" e "Publishable" (ou "anon key").

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave PÚBLICA (sb_publishable_... ou a antiga anon). Pode ir para o navegador:
# o acesso aos dados é controlado pelas regras (RLS) da migração em supabase/migrations.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Mesmo valor de VOLTLENS_LOGIN_DOMAIN no .env da raiz.
VITE_LOGIN_DOMAIN=voltlens.local
